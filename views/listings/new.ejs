<%- layout('/layouts/boilerplate') %>
<body>
  <br />
  <br />
  <div class="row">
    <div class="col-8 offset-2">
      <h1>Create new route</h1>
      <form action="/listing" method="post" invalid>
        <div>
          <label for="title" class="form-label">Title</label>
          <input type="text" name="listing[title]" class="form-control" />
        </div>

        <div>
          <label for="description" class="form-label">Description</label>
          <textarea
            type="text"
            name="listing[description]"
            class="form-control"
            required
          >
          </textarea>
        </div>
        <div class="row">
          <div class="row mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              type="text"
              name="listing[price]"
              placeholder="write price"
              class="form-control"
              required
            />
          </div>

          <div class="row mb-3 col-md-8 ">
            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" class="form-control" required />
          </div>
        </div>

        <div>
          <label for="image" class="form-label">Image URL</label>
          <input
            type="text "
            name="listing[image]"
            placeholder="write image url"
            class="form-control"
            required
          />
        </div>

        <div>
          <label for="country" class="form-label">Country</label>
          <input
            type="text"
            name="listing[country]"
            placeholder="write country"
            class="form-control"
            required
          />
        </div>
        <br />

        <button class="btn btn-danger" type="submit">Add</button>
      </form>
    </div>
  </div>
  <br />
  <br />
</body>
