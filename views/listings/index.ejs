<%- layout('/layouts/boilerplate') %>
<body>
    <h3>Our Listings</h3>
    <form action="/listing/new" method="get"><button>Create New listing</button></form>
    <%for(let listing of listings){%>
    <ul>
        <a href="/listing/<%=listing._id%>"><li><%= listing.title %></li></a>
    </ul>
<%}%>
    
</body>

